# Runtime
NODE_ENV=production
PORT=3001

# API behavior
CORS_ORIGIN=https://your-frontend.example.com
RATE_LIMIT_MAX=30
CAPTURE_CONCURRENCY=3
WORKLOAD_CONCURRENCY=3
TENANT_WORKLOAD_CONCURRENCY=1
WORKLOAD_QUEUE_MAX=100
RIVE_DEBUG_DIR=

# Auth
# Production login uses a signed HttpOnly session cookie. AUTH_SESSION_SECRET
# should be independent from the password and at least 32 random bytes.
AUTH_MODE=production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
AUTH_SESSION_SECRET=change-me-to-a-long-random-secret

# Trusted proxy mode is for a separately authenticated, private gateway only.
# The bundled nginx configuration deliberately strips these headers.
# AUTH_MODE=trusted-proxy
# AUTH_HEADERS_USE_AUTH_PREFIX=true
# AUTH_USER_ID_HEADER=x-auth-user-id
# AUTH_TENANT_ID_HEADER=x-auth-tenant-id
# AUTH_CLIENT_ID_HEADER=x-auth-client-id
